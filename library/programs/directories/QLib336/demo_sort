670 DEFine PROCedure print_array(ara)
680  CLS #5: PRINT #5,ara(1 TO)!
690 END DEFine print_array
700 :
710 DEFine PROCedure randchar(ara)
720   LOCal i,j
730   FOR i=1 TO DIMN(ara,1)
740     FOR j=1 TO DIMN(ara,2)
750       ara(i,j)=CHR$(RND(65 TO 90))
760     END FOR j
770     ara(i,0)=DIMN(ara,2)
780   END FOR i
785   CLS #5: PRINT #5,ara(1 TO)!
790 END DEFine randchar
