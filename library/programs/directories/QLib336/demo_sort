1050 DEFine PROCedure intro
1060   PRINT #5;"This program shows the dramatic"
1070   PRINT #5;"speed increase which Q_Liberator can"
1080   PRINT #5;"impart to a program."\\
1090   PRINT #5;"It creates arrays of random numbers"
1100   PRINT #5;"or characters and sorts them into"
1110   PRINT #5;"ascending order."\\
1120   PRINT #5;"The sort procedure is adapted from"
1130   PRINT #5;"that described on page 100 of the"
1140   PRINT #5;"QL User Guide."\\
1150   PRINT #5;"Note that the one procedure can"
1160   PRINT #5;"be used to sort any type of array."\\
1170   INPUT #4;"How many elements (10-100) ";max$
1180   max=0&max$:
1190   SELect ON max
1200     =10 TO 100
1210     =REMAINDER : max=100
1220   END SELect 
1230 END DEFine intro
1240 :
1250 DEFine PROCedure sort(ara)
1260 REMark $$i
1270 REMark Insertion Sort
1280   PRINT #4;"Sorting ... "
1285   BEEP 500,20
1290   IF DIMN(ara)<2 THEN RETurn 
1300   FOR item=2 TO DIMN(ara)
1310     p%=item
1320     ara(0)=ara(p%)
1330     REPeat compare
1340       IF ara(0)>=ara(p%-1):EXIT compare
1350       ara(p%)=ara(p%-1)
1360       p%=p%-1
1370     END REPeat compare
1380     ara(p%)=ara(0)
1390   END FOR item
1400   CLS #4
1410 REMark $$f
1420 END DEFine 
1430 :
1440 DEFine PROCedure wait
1450   PRINT #4,\"Hit space to continue"
1460   BEEP 500,20
1470   REPeat waiting
1480     IF KEYROW(1)=64 THEN EXIT waiting
1490   END REPeat waiting
1500   CLS #4
1510 END DEFine wait
