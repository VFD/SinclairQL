4040   LOCal i, n, idx, w, s, e, p
4050   s = 5000
4060   e = 5300
4070   p = 10
4080   w = 6
4090   n = RND(0 TO (e - s) / p) * p + s
4100   idx = RND(1 TO w)
4110   RESTORE n
4120   FOR i = 1 TO idx
4130     READ w$
4140   END FOR i
4150   RETurn w$
4160 END DEFine PICKWORD
